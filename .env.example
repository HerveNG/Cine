# --- Postgres (used by docker-compose) ---
POSTGRES_USER=filmfund
POSTGRES_PASSWORD=filmfund
POSTGRES_DB=filmfund

# --- Backend (FastAPI) ---
# Compatible with local Postgres, Supabase, or Neon — just point this at
# whichever Postgres instance you're using.
DATABASE_URL=postgresql+psycopg2://filmfund:filmfund@localhost:5432/filmfund
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000"]

# --- AI provider abstraction (see backend/app/services, Phase 2) ---
# AI_PROVIDER: "openai" | "anthropic" | "local" | "none"
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# --- Automation (n8n, Phase 6) ---
N8N_WEBHOOK_URL=
N8N_USER=admin
N8N_PASSWORD=changeme

# --- Email (SMTP) — used for password reset, notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- File storage (documents, exports) ---
STORAGE_URL=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Never commit a real .env file with actual secrets to the repository.
